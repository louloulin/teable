{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Teable OSS production overview — HTTP, DB, automation, webhook, AI, errors. Importable into vanilla Grafana 10.x against a Prometheus datasource scraping the teable backend's /metrics endpoint.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "teable-overview",
  "title": "Teable OSS — Production Overview",
  "tags": ["teable", "oss", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(teable_http_request_duration_seconds_count, job)",
        "current": { "text": "teable-backend", "value": "teable-backend" },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(teable_http_request_duration_seconds_count{job=~\"$job\"}[5m])) by (route, method)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Latency P50 / P95 / P99",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(teable_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(teable_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(teable_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (5xx / total)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(teable_http_request_duration_seconds_count{job=~\"$job\", code=~\"5..\"}[5m])) / clamp_min(sum(rate(teable_http_request_duration_seconds_count{job=~\"$job\"}[5m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB Query Duration (P95)",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(teable_db_query_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le, op))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB Connection Pool (active / idle / waiting)",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "teable_db_pool_active{job=~\"$job\"}", "legendFormat": "active", "refId": "A" },
        { "expr": "teable_db_pool_idle{job=~\"$job\"}", "legendFormat": "idle", "refId": "B" },
        { "expr": "teable_db_pool_waiting{job=~\"$job\"}", "legendFormat": "waiting", "refId": "C" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB Pool Saturation (%)",
      "gridPos": { "x": 16, "y": 6, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "teable_db_pool_active{job=~\"$job\"} / clamp_min(teable_db_pool_max{job=~\"$job\"}, 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Automation Runs / min (success / fail)",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(teable_automation_runs_total{job=~\"$job\", status=\"success\"}[5m])) * 60",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(teable_automation_runs_total{job=~\"$job\", status=\"failed\"}[5m])) * 60",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Automation Run Duration (P95)",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(teable_automation_run_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le, trigger))",
          "legendFormat": "{{trigger}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Automation Backlog (queued)",
      "gridPos": { "x": 16, "y": 12, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "teable_automation_queue_size{job=~\"$job\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Webhook Delivery (success / failure / DLQ)",
      "gridPos": { "x": 0, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(teable_webhook_delivery_total{job=~\"$job\", outcome=\"success\"}[5m])) * 60",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(teable_webhook_delivery_total{job=~\"$job\", outcome=\"failed\"}[5m])) * 60",
          "legendFormat": "failed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(teable_webhook_delivery_total{job=~\"$job\", outcome=\"dead_letter\"}[5m])) * 60",
          "legendFormat": "DLQ",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "AI Calls (rate + P95 latency)",
      "gridPos": { "x": 8, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(teable_ai_calls_total{job=~\"$job\", outcome=\"success\"}[5m])) * 60",
          "legendFormat": "success/min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(teable_ai_calls_total{job=~\"$job\", outcome=\"failed\"}[5m])) * 60",
          "legendFormat": "failed/min",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(teable_ai_call_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95 latency" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Process RSS / Heap",
      "gridPos": { "x": 16, "y": 18, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "teable_process_resident_memory_bytes{job=~\"$job\"}", "refId": "A" },
        { "expr": "teable_process_heap_bytes{job=~\"$job\"}", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 2147483648 }
            ]
          }
        }
      }
    }
  ]
}