{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-import",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": true,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/core": ["../../core/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "./src/**/*.spec.ts",
    "./src/**/*.test.ts",
    "./src/**/__tests__/**",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../core/src/**/__tests__/**",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../core/src/**/__tests__/**"
  ],
  "include": ["src", "../core/src", "../di/src", "../../core/src"]
}
