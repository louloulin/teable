{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-container-browser",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": true,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/v2-adapter-db-postgres-pg": ["../adapter-db-postgres-pg/src"],
      "@teable/v2-adapter-db-postgres-pglite": ["../adapter-db-postgres-pglite/src"],
      "@teable/v2-adapter-record-repository-postgres": [
        "../adapter-record-repository-postgres/src"
      ],
      "@teable/v2-adapter-repository-postgres": ["../adapter-repository-postgres/src"],
      "@teable/v2-adapter-table-repository-postgres": ["../adapter-table-repository-postgres/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/core": ["../../core/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "./src/**/*.spec.ts",
    "./src/**/*.test.ts",
    "./src/**/__tests__/**",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../core/src/**/__tests__/**",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../core/src/**/__tests__/**",
    "../adapter-db-postgres-pg/src/**/*.spec.ts",
    "../adapter-db-postgres-pg/src/**/*.test.ts",
    "../adapter-db-postgres-pg/src/**/__tests__/**",
    "../adapter-db-postgres-pglite/src/**/*.spec.ts",
    "../adapter-db-postgres-pglite/src/**/*.test.ts",
    "../adapter-db-postgres-pglite/src/**/__tests__/**",
    "../adapter-record-repository-postgres/src/**/*.spec.ts",
    "../adapter-record-repository-postgres/src/**/*.test.ts",
    "../adapter-record-repository-postgres/src/**/__tests__/**",
    "../adapter-repository-postgres/src/**/*.spec.ts",
    "../adapter-repository-postgres/src/**/*.test.ts",
    "../adapter-repository-postgres/src/**/__tests__/**",
    "../adapter-table-repository-postgres/src/**/*.spec.ts",
    "../adapter-table-repository-postgres/src/**/*.test.ts",
    "../adapter-table-repository-postgres/src/**/__tests__/**"
  ],
  "include": [
    "src",
    "../adapter-db-postgres-pg/src",
    "../adapter-db-postgres-pglite/src",
    "../adapter-record-repository-postgres/src",
    "../adapter-repository-postgres/src",
    "../adapter-table-repository-postgres/src",
    "../core/src",
    "../di/src",
    "../../core/src"
  ]
}
