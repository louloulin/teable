{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-adapter-db-postgres-pg",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "target": "esnext",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": true,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/v2-adapter-db-postgres-shared": ["../adapter-db-postgres-shared/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/core": ["../../core/src"]
    }
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "./src/**/*.spec.ts",
    "./src/**/*.test.ts",
    "./src/**/__tests__/**",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../core/src/**/__tests__/**",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../core/src/**/__tests__/**"
  ],
  "include": [
    "src",
    "../adapter-db-postgres-shared/src",
    "../core/src",
    "../di/src",
    "../../core/src"
  ]
}
