  sourceId   String   @map("source_id")
  /// "row.created" | "row.updated" | "row.deleted" | "schema.changed"
  kind       String
  occurredAt DateTime @map("occurred_at")
  summary    String   @default("")
  processed  Boolean  @default(false)

  @@index([viewId, processed])
  @@map("federation_event")
}

model FederationRefresh {
  id             String    @id
  viewId         String    @map("view_id")
  /// "pending" | "running" | "done" | "failed"
  status         String
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  eventsConsumed Int       @default(0) @map("events_consumed")
  rowsWritten    Int       @default(0) @map("rows_written")
  durationMs     Int?      @map("duration_ms")
  lastError      String?   @map("last_error")

  @@index([viewId, status])
  @@map("federation_refresh")
}

model RiskPolicy {
  id            String   @id
  orgId         String   @map("org_id")
  defaultAction String   @map("default_action")
  auditAll      Boolean  @default(true) @map("audit_all")
  rulesJson     String   @default("[]") @map("rules_json")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("risk_policy")
}

model RiskDecision {
  id             String   @id
  orgId          String   @map("org_id")
  actorId        String   @map("actor_id")
  score          Int      @default(0)
  /// "low" | "medium" | "high" | "critical"
  band           String
  /// "allow" | "challenge" | "soft-block" | "hard-block"
  action         String
  firedRulesJson String   @default("[]") @map("fired_rules_json")
  detail         String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@index([actorId, createdAt])
  @@map("risk_decision")
}

model LoginAttempt {
  id              String   @id
  orgId           String   @map("org_id")
  actorId         String   @map("actor_id")
  deviceId        String   @map("device_id")
  ip              String
  countryCode     String   @map("country_code")
  regionCode      String   @map("region_code")
  tzOffsetMinutes Int      @map("tz_offset_minutes")
  userAgent       String   @map("user_agent")
  /// "success" | "mfa-challenge" | "soft-blocked" | "hard-blocked" | "failed"
  outcome         String
  band            String   @default("low")
  failureReason   String?  @map("failure_reason")
  occurredAt      DateTime @map("occurred_at")

  @@index([actorId, occurredAt])
  @@index([orgId, occurredAt])
  @@map("login_attempt")
}

model OrgBanEntry {
  id             String    @id
  orgId          String    @map("org_id")
  /// "ip" | "email" | "device" | "actor" | "country"
  kind           String
  value          String
  /// "allow" | "block"
  mode           String
  reason         String
  expiresAt      DateTime? @map("expires_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastModifiedBy String?   @map("last_modified_by")
  revokedAt      DateTime? @map("revoked_at")

  @@index([orgId, kind, value])
  @@index([orgId, mode])
  @@map("org_ban_entry")
}

model OrgBanAudit {
  id         String   @id
  orgId      String   @map("org_id")
  entryId    String   @map("entry_id")
  /// "create" | "revoke" | "edit"
  action     String
  actorId    String   @map("actor_id")
  detail     String   @default("")
  occurredAt DateTime @map("occurred_at")

  @@index([entryId, occurredAt])
  @@index([orgId, occurredAt])
  @@map("org_ban_audit")
}

model QuotaSample {
  id      String   @id
  orgId   String   @map("org_id")
  /// "rows" | "apiCalls" | "storage" | "aiCredits" | "webhooks" | "attachments"
  metric  String
  endedAt DateTime @map("ended_at")
  value   BigInt   @default(0)
  cap     BigInt   @default(0)

  @@index([orgId, metric, endedAt])
  @@map("quota_sample")
}

model QuotaAnomalyReport {
  id           String   @id
  orgId        String   @map("org_id")
  /// "rows" | "apiCalls" | "storage" | "aiCredits" | "webhooks" | "attachments"
  metric       String
  /// "info" | "warning" | "critical"
  severity     String
  ratio        Float    @default(0)
  capRatio     Float    @default(0) @map("cap_ratio")
  channelsJson String   @default("[]") @map("channels_json")
  detail       String   @default("")
  detectedAt   DateTime @map("detected_at")

  @@index([orgId, metric, detectedAt])
  @@map("quota_anomaly_report")
}

model SeatAssignment {
  id          String    @id
  orgId       String    @map("org_id")
  actorId     String    @map("actor_id")
  /// "starter" | "pro" | "enterprise"
  tier        String
  /// "active" | "invited" | "deactivated" | "pending"
  status      String
  assignedAt  DateTime  @map("assigned_at")
  removedAt   DateTime? @map("removed_at")
  cycleAnchor DateTime  @map("cycle_anchor")

  @@index([orgId, tier, status])
  @@index([orgId, cycleAnchor])
  @@map("seat_assignment")
}

model SeatCycle {
  id             String   @id
  orgId          String   @map("org_id")
  /// "starter" | "pro" | "enterprise"
  tier           String
  startedAt      DateTime @map("started_at")
  endedAt        DateTime @map("ended_at")
  seatsActive    Int      @default(0) @map("seats_active")
  seatsProrated  Float    @default(0) @map("seats_prorated")
  unitPriceCents Int      @default(0) @map("unit_price_cents")
  totalCents     Int      @default(0) @map("total_cents")

  @@index([orgId, tier, startedAt])
  @@map("seat_cycle")
}

model StorageSample {
  id      String   @id
  orgId   String   @map("org_id")
  baseId  String   @map("base_id")
  /// "records" | "attachments" | "snapshots" | "history" | "other"
  kind    String
  bytes   BigInt   @default(0)
  endedAt DateTime @map("ended_at")

  @@index([orgId, baseId, endedAt])
  @@map("storage_sample")
}

model StorageBillableLine {
  id        String   @id
  orgId     String   @map("org_id")
  baseId    String   @map("base_id")
  bytes     BigInt   @default(0)
  cents     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("storage_billable_line")
}

model LicenseKey {
  id           String    @id
  orgId        String    @map("org_id")
  /// "community" | "pro" | "business" | "enterprise"
  tier         String    @default("community")
  /// Next tier change is allowed after this timestamp.
  nextChangeAt DateTime? @map("next_change_at")
  activatedAt  DateTime? @map("activated_at")
  expiresAt    DateTime? @map("expires_at")

  @@index([orgId, tier])
  @@map("license_key")
}

model LicenseTierAudit {
  id          String   @id
  licenseId   String   @map("license_id")
  /// "community" | "pro" | "business" | "enterprise"
  from        String
  to          String
  /// "upgrade" | "downgrade" | "lateral"
  direction   String
  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")
  reason      String?
  actorId     String?  @map("actor_id")

  @@index([licenseId, effectiveAt])
  @@map("license_tier_audit")
}

model StripeWebhookEvent {
  id                 String   @id
  /// see STRIPE_EVENT_KINDS
  kind               String
  createdAt          DateTime @map("created_at")
  invoiceId          String?  @map("invoice_id")
  signature          String
  signatureTimestamp Int      @map("signature_timestamp")

  @@index([invoiceId, createdAt])
  @@map("stripe_webhook_event")
}

model StripeReconciliationEntry {
  id            String    @id
  eventId       String    @map("event_id")
  invoiceId     String    @map("invoice_id")
  lineItemId    String    @map("line_item_id")
  /// "pending" | "matched" | "mismatch" | "applied"
  status        String
  expectedCents Int       @map("expected_cents")
  actualCents   Int       @map("actual_cents")
  deltaCents    Int       @map("delta_cents")
  appliedAt     DateTime? @map("applied_at")
  reason        String?

  @@index([invoiceId, status])
  @@map("stripe_reconciliation_entry")
}

model InternalBillableLine {
  id         String @id
  invoiceId  String @map("invoice_id")
  lineItemId String @map("line_item_id")
  cents      Int    @default(0)

  @@index([invoiceId])
  @@map("internal_billable_line")
}

model BillingInvoice {
  id            String   @id
  orgId         String   @map("org_id")
  customerName  String   @map("customer_name")
  customerEmail String?  @map("customer_email")
  /// "USD" | "EUR" | "GBP" | "JPY" | "CNY"
  currency      String
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  issuedAt      DateTime @map("issued_at")
  /// JSON-encoded IBillingLineItem[]
  lines         Json
  taxBps        Int      @default(0) @map("tax_bps")
  notes         String?

  @@index([orgId, periodStart])
  @@map("billing_invoice")
}

model BillingPdfExport {
  id        String   @id
  invoiceId String   @map("invoice_id")
  bytes     Bytes
  size      Int
  sha256    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId, createdAt])
  @@map("billing_pdf_export")
}

model FieldTypeMap {
  id         String  @id
  orgId      String  @map("org_id")
  /// "string" | "number" | "integer" | "boolean" | "date" | "datetime" | "json" | "array" | "attachment" | "enum"
  source     String
  target     String
  /// "direct" | "cast" | "parse" | "serialize" | "reject"
  conversion String
  lossless   Boolean
  notes      String?

  @@index([orgId, source, target])
  @@map("field_type_map")
}

model ConversionPipeline {
  id        String   @id
  orgId     String   @map("org_id")
  name      String
  /// JSON-encoded IPipelineStep[]
  steps     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("conversion_pipeline")
}

model ConflictEvent {
  id             String    @id
  orgId          String    @map("org_id")
  recordId       String    @map("record_id")
  /// "optimistic-lock" | "duplicate-write" | "stale-read" | "incompatible-version"
  kind           String
  idempotencyKey String    @map("idempotency_key")
  offset         Int
  attempts       Int       @default(0)
  lastError      String?
  enqueuedAt     DateTime  @map("enqueued_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@index([orgId, offset])
  @@index([idempotencyKey])
  @@map("conflict_event")
}

model ImportJob {
  id         String   @id
  orgId      String   @map("org_id")
  /// "import" | "export"
  direction  String
  /// "csv" | "json" | "xlsx"
  format     String
  sourceUri  String?  @map("source_uri")
  targetUri  String?  @map("target_uri")
  chunkSize  Int      @map("chunk_size")
  maxRows    Int      @map("max_rows")
  deadline   DateTime
  checkpoint Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("import_job")
}

model ModuleEntry {
  id            String   @id
  /// Feature module name (one of FEATURE_MODULE_NAMES)
  name          String
  registered    Boolean  @default(false)
  hasController Boolean  @default(false) @map("has_controller")
  guarded       Boolean  @default(false)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("module_entry")
}

model ControllerSpec {
  id        String   @id
  /// Resource name (path segment)
  resource  String
  /// Routes under the controller
  routes    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resource])
  @@map("controller_spec")
}
