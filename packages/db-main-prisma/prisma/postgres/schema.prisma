/// Cloud parity — Phase 5.3 / dunning plan.
///
/// A plan tracks one recovery sequence for a subscription that has entered
/// `past_due`. Steps are pre-scheduled at T+24h / T+72h / T+7d / T+14d from
/// the moment the plan was opened; recovery to `active` (or cancellation)
/// cancels any pending steps. The worker that executes the steps lives in a
/// separate process; this table is the source-of-truth for what should run.
model BillingDunningPlan {
  id             String   @id
  subscriptionId String   @map("subscription_id")
  /// "active" | "recovered" | "completed"
  status         String   @default("active")
  reason         String?
  openedAt       DateTime @default(now()) @map("opened_at")
  resolvedAt     DateTime? @map("resolved_at")
  createdTime    DateTime @default(now()) @map("created_time")
  updatedTime    DateTime @updatedAt @map("updated_time")

  steps BillingDunningStep[]

  @@index([subscriptionId, status])
  @@index([status, resolvedAt])
  @@map("billing_dunning_plan")
}

/// One scheduled recovery step inside a dunning plan. The worker reads
/// `status = "scheduled" AND dueAt <= now()` and atomically claims it
/// by transitioning to `executed` (with `executedAt`) or `canceled`.
model BillingDunningStep {
  id        String   @id
  planId    String   @map("plan_id")
  /// "T1_DUNNING_EMAIL" | "T2_DUNNING_RETRY" | "T3_FINAL_NOTICE" | "T14_CANCEL"
  kind      String
  /// "scheduled" | "executed" | "canceled"
  status    String   @default("scheduled")
  dueAt     DateTime @map("due_at")
  executedAt DateTime? @map("executed_at")
  canceledAt DateTime? @map("canceled_at")
  /// Free-form worker output (audit / last error). Mirrors the Phase 1
  /// durable-task result pattern.
  result    Json?
  createdTime DateTime @default(now()) @map("created_time")
  updatedTime DateTime @updatedAt @map("updated_time")

  plan BillingDunningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dueAt])
  @@index([status, dueAt])
  @@unique([planId, kind])
  @@map("billing_dunning_step")
}

/// Unified usage ledger (Phase 5.5 part 1).
///
/// Append-only event log of metered consumption. Every feature that
/// generates billable usage (AI credits, automation runs, record
/// overage, storage growth, email sends) writes one row per event
/// with a stable `metric` label. The Customer Portal aggregates
/// events inside `[periodStart, periodEnd)` for a given org and
/// renders overage previews + final invoices.
///
/// Idempotency: `(organizationId, idempotencyKey)` is unique so a
/// retried record call from a worker becomes a no-op rather than a
/// double charge. `metadata` carries the source feature, the
/// request id, and any other forensic field the producer wants to
/// keep (e.g. token counts, attachment IDs).
model BillingUsageEvent {
  id              String   @id
  organizationId  String   @map("organization_id")
  /// "ai_credits" | "automation_runs" | "records" | "storage_bytes" | "email_sends"
  metric          String
  quantity        BigInt   @default(0)
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  /// Source feature that produced the event — e.g. "ai-chat",
  /// "automation", "record-bulk-create", "attachments".
  source          String
  idempotencyKey  String?  @map("idempotency_key")
  metadata        Json?
  recordedAt      DateTime @default(now()) @map("recorded_at")
  createdTime     DateTime @default(now()) @map("created_time")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, metric, periodStart, periodEnd])
  @@index([metric, recordedAt])
  @@map("billing_usage_event")
}

/// Add-on subscriptions (Phase 5.5 part 2).
///
/// Packs a customer can stack on top of their base plan: extra AI
/// credits, automation runs, record overage allowance, storage GB.
/// Each add-on has a fixed monthly price + a metric quantity it
/// grants; the granted quantity is added to `includedQuantity`
/// when computing overage.
///
/// Lifecycle: `active → canceled (atPeriodEnd=true) → expired (period ends)`.
/// Workers flip `active → expired` when `currentPeriodEnd <= now`.
model BillingAddOn {
  id              String   @id
  organizationId  String   @map("organization_id")
  /// "ai_credits" | "automation_runs" | "records" | "storage_bytes"
  metric          String
  /// Pack display code, e.g. "ai-credits-100k", "automation-runs-500".
  packCode        String   @map("pack_code")
  /// Quantity granted per period by this add-on (BigInt for storage).
  grantedQuantity BigInt   @map("granted_quantity")
  /// Monthly price in cents for this pack.
  monthlyPriceCents Int    @map("monthly_price_cents")
  currency        String   @default("usd")
  /// "active" | "canceled" | "expired"
  status          String   @default("active")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  canceledAt     DateTime? @map("canceled_at")
  createdTime    DateTime  @default(now()) @map("created_time")
  updatedTime    DateTime  @updatedAt @map("updated_time")

  @@index([organizationId, status])
  @@unique([organizationId, packCode, currentPeriodStart])
  @@map("billing_add_on")
}

