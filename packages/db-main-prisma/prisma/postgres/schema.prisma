/// Unified source-import task (Cloud §migrations). Backed by the durable
/// `queued/running/succeeded/failed/canceled` protocol shared with AI Chat
/// long task, AI Field batch, and Stripe webhook events.
model SourceImportTask {
  id              String    @id
  /// "notion" | "google_sheets" | "airtable" | ...
  source          String
  /// Stable idempotency key supplied by the caller (typically
  /// `${source}:${spaceId}:${remoteId}:${tableId}:v${revision}`).
  idempotencyKey  String?   @map("idempotency_key")
  spaceId         String?   @map("space_id")
  baseId          String?   @map("base_id")
  tableId         String?   @map("table_id")
  remoteId        String?   @map("remote_id")
  triggeredBy     String?   @map("triggered_by")
  tenantId        String?   @map("tenant_id")
  correlationId   String?   @map("correlation_id")
  /// "queued" | "running" | "succeeded" | "failed" | "canceled"
  status          String    @default("queued")
  attempt         Int       @default(0)
  maxAttempts     Int       @default(3) @map("max_attempts")
  totalCount      Int       @default(0) @map("total_count")
  processedCount  Int       @default(0) @map("processed_count")
  failedCount     Int       @default(0) @map("failed_count")
  heartbeatAt     DateTime? @map("heartbeat_at")
  leaseUntil      DateTime? @map("lease_until")
  retryAt         DateTime? @map("retry_at")
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  lastError       String?   @map("last_error")
  errorCode       String?   @map("error_code")
  payload         Json?
  result          Json?
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdTime     DateTime  @default(now()) @map("created_time")
  updatedTime     DateTime  @updatedAt @map("updated_time")

  @@index([status, createdTime])
  @@index([source, status])
  @@index([status, leaseUntil])
  @@unique([source, idempotencyKey])
  @@map("source_import_task")
}


