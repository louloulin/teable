  orgId   String   @map("org_id")
  baseId  String   @map("base_id")
  /// "records" | "attachments" | "snapshots" | "history" | "other"
  kind    String
  bytes   BigInt   @default(0)
  endedAt DateTime @map("ended_at")

  @@index([orgId, baseId, endedAt])
  @@map("storage_sample")
}

model StorageBillableLine {
  id        String   @id
  orgId     String   @map("org_id")
  baseId    String   @map("base_id")
  bytes     BigInt   @default(0)
  cents     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("storage_billable_line")
}

model LicenseKey {
  id           String    @id
  orgId        String    @map("org_id")
  /// "community" | "pro" | "business" | "enterprise"
  tier         String    @default("community")
  /// Next tier change is allowed after this timestamp.
  nextChangeAt DateTime? @map("next_change_at")
  activatedAt  DateTime? @map("activated_at")
  expiresAt    DateTime? @map("expires_at")

  @@index([orgId, tier])
  @@map("license_key")
}

model LicenseTierAudit {
  id          String   @id
  licenseId   String   @map("license_id")
  /// "community" | "pro" | "business" | "enterprise"
  from        String
  to          String
  /// "upgrade" | "downgrade" | "lateral"
  direction   String
  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")
  reason      String?
  actorId     String?  @map("actor_id")

  @@index([licenseId, effectiveAt])
  @@map("license_tier_audit")
}

model StripeWebhookEvent {
  id                 String   @id
  /// see STRIPE_EVENT_KINDS
  kind               String
  createdAt          DateTime @map("created_at")
  invoiceId          String?  @map("invoice_id")
  signature          String
  signatureTimestamp Int      @map("signature_timestamp")
  /// "queued" | "processing" | "succeeded" | "failed"
  status             String   @default("queued")
  attempt            Int      @default(0)
  maxAttempts        Int      @default(5) @map("max_attempts")
  heartbeatAt        DateTime? @map("heartbeat_at")
  leaseUntil         DateTime? @map("lease_until")
  retryAt            DateTime? @map("retry_at")
  lastError          String?  @map("last_error")
  errorCode          String?  @map("error_code")
  tenantId           String?  @map("tenant_id")
  correlationId      String?  @map("correlation_id")
  processedAt        DateTime? @map("processed_at")

  @@index([invoiceId, createdAt])
  @@index([status, leaseUntil])
  @@map("stripe_webhook_event")
}

model StripeReconciliationEntry {
  id            String    @id
  eventId       String    @map("event_id")
  invoiceId     String    @map("invoice_id")
  lineItemId    String    @map("line_item_id")
  /// "pending" | "matched" | "mismatch" | "applied"
  status        String
  expectedCents Int       @map("expected_cents")
  actualCents   Int       @map("actual_cents")
  deltaCents    Int       @map("delta_cents")
  appliedAt     DateTime? @map("applied_at")
  reason        String?

  @@index([invoiceId, status])
  @@map("stripe_reconciliation_entry")
}

model InternalBillableLine {
  id         String @id
  invoiceId  String @map("invoice_id")
  lineItemId String @map("line_item_id")
  cents      Int    @default(0)

  @@index([invoiceId])
  @@map("internal_billable_line")
}

model BillingInvoice {
  id            String   @id
  orgId         String   @map("org_id")
  customerName  String   @map("customer_name")
  customerEmail String?  @map("customer_email")
  /// "USD" | "EUR" | "GBP" | "JPY" | "CNY"
  currency      String
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  issuedAt      DateTime @map("issued_at")
  /// JSON-encoded IBillingLineItem[]
  lines         Json
  taxBps        Int      @default(0) @map("tax_bps")
  notes         String?

  @@index([orgId, periodStart])
  @@map("billing_invoice")
}

model BillingPdfExport {
  id        String   @id
  invoiceId String   @map("invoice_id")
  bytes     Bytes
  size      Int
  sha256    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId, createdAt])
  @@map("billing_pdf_export")
}

model FieldTypeMap {
  id         String  @id
  orgId      String  @map("org_id")
  /// "string" | "number" | "integer" | "boolean" | "date" | "datetime" | "json" | "array" | "attachment" | "enum"
  source     String
  target     String
  /// "direct" | "cast" | "parse" | "serialize" | "reject"
  conversion String
  lossless   Boolean
  notes      String?

  @@index([orgId, source, target])
  @@map("field_type_map")
}

model ConversionPipeline {
  id        String   @id
  orgId     String   @map("org_id")
  name      String
  /// JSON-encoded IPipelineStep[]
  steps     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("conversion_pipeline")
}

model ConflictEvent {
  id             String    @id
  orgId          String    @map("org_id")
  recordId       String    @map("record_id")
  /// "optimistic-lock" | "duplicate-write" | "stale-read" | "incompatible-version"
  kind           String
  idempotencyKey String    @map("idempotency_key")
  offset         Int
  attempts       Int       @default(0)
  lastError      String?
  enqueuedAt     DateTime  @map("enqueued_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@index([orgId, offset])
  @@index([idempotencyKey])
  @@map("conflict_event")
}

model ImportJob {
  id         String   @id
  orgId      String   @map("org_id")
  /// "import" | "export"
  direction  String
  /// "csv" | "json" | "xlsx"
  format     String
  sourceUri  String?  @map("source_uri")
  targetUri  String?  @map("target_uri")
  chunkSize  Int      @map("chunk_size")
  maxRows    Int      @map("max_rows")
  deadline   DateTime
  checkpoint Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("import_job")
}

model ModuleEntry {
  id            String   @id
  /// Feature module name (one of FEATURE_MODULE_NAMES)
  name          String
  registered    Boolean  @default(false)
  hasController Boolean  @default(false) @map("has_controller")
  guarded       Boolean  @default(false)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("module_entry")
}

model ControllerSpec {
  id        String   @id
  /// Resource name (path segment)
  resource  String
  /// Routes under the controller
  routes    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resource])
  @@map("controller_spec")
}

model GuardAudit {
  id         String   @id
  /// "read" | "create" | "update" | "delete" | "export" | "admin"
  action     String
  principal  String
  resourceId String?  @map("resource_id")
  /// "ok" | "denied" | "error"
  outcome    String
  context    Json
  occurredAt DateTime @map("occurred_at")

  @@index([action])
  @@index([principal])
  @@map("guard_audit")
}

model OpenApiOperation {
  id           String   @id
  operationId  String   @map("operation_id")
  resource     String
  verb         String
  path         String
  summary      String
  authRequired Boolean  @default(true) @map("auth_required")
  params       Json
  body         Json?
  responses    Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([resource])
  @@map("openapi_operation")
}

model TestFixture {
  id     String @id
  /// Stable seed for replay
  seed   String
  org    Json
  users  Json
  tokens Json

  @@map("test_fixture")
}

model TestCallLog {
  id         String   @id
  seed       String
  verb       String
  path       String
  status     Int
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([seed])
  @@map("test_call_log")
}

model AppModuleWire {
  id        String   @id
  /// NestJS module class name
  name      String
  /// "core" | "infra" | "feature"
  category  String
  round     Int
  required  Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([round])
  @@map("app_module_wire")
}

model EnvSpec {
  id           String   @id
  name         String
  /// "string" | "number" | "boolean" | "enum"
  kind         String
  required     Boolean
  defaultValue String?  @map("default_value")
  enumValues   Json?
  description  String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("env_spec")
}

model AutomationCanvas {
  id        String   @id
  baseId    String   @map("base_id")
  name      String
  /// JSON: {nodes, edges, viewport, version}
  graphJson Json     @map("graph_json")
  version   Int      @default(1)
  /// SHA-256 of the canonical JSON for fast equality checks
  hash      String
  createdBy String   @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([baseId])
  @@map("automation_canvas")
}

model AutomationCanvasRevision {
  id        String   @id
  canvasId  String   @map("canvas_id")
  version   Int
  /// JSON snapshot at the time of revision
  graphJson Json     @map("graph_json")
  hash      String
  author    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([canvasId, version])
  @@map("automation_canvas_revision")
}

model AutomationTriggerCatalog {
  id          String   @id
  /// Trigger type id, e.g. 'record_created'
  type        String   @unique
  label       String
  /// "record" | "schedule" | "webhook" | "manual" | "system"
  category    String
  description String?
  icon        String?
  /// JSON: field spec array
  fieldsJson  Json     @map("fields_json")
  /// JSON: output key list
  outputKeys  Json     @map("output_keys")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("automation_trigger_catalog")
}

model AutomationActionCatalog {
  id          String   @id
  /// Action type id, e.g. 'update_record'
  type        String   @unique
  label       String
  /// "record" | "notification" | "integration" | "ai" | "system"
  category    String
  description String?
  icon        String?
  /// JSON: field spec array
  fieldsJson  Json     @map("fields_json")
  /// JSON: {maxAttempts, backoff, initialDelayMs}
  retryJson   Json?    @map("retry_json")
  rollback    Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("automation_action_catalog")
}

model WebhookCanvas {
  id        String   @id
  baseId    String   @map("base_id")
  name      String
  /// JSON: nodes/edges
  canvasJson Json    @map("canvas_json")
  version   Int      @default(1)
  hash      String
  createdBy String   @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([baseId])
  @@map("webhook_canvas")
}

model DrCanvas {
  id        String   @id
  baseId    String   @map("base_id")
  name      String
  /// JSON: nodes/edges/target
  canvasJson Json    @map("canvas_json")
  /// "primary" → "replica" etc
  sourceRegion String  @map("source_region")
  destRegion   String  @map("dest_region")
  version   Int      @default(1)
  hash      String
  createdBy String   @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([baseId])
  @@map("dr_canvas")
}

model ViewMetadata {
  id        String   @id
  baseId    String   @map("base_id")
  tableId   String   @map("table_id")
  name      String
  /// "grid" | "kanban" | "gallery" | "calendar" | "form" | "map" | "timeline"
  kind      String
  /// JSON: full ViewMetadataSpec
  metadata  Json
  version   Int      @default(1)
  /// SHA-256 hash for fast equality
  hash      String
  createdBy String   @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([baseId])
  @@index([tableId, kind])
  @@map("view_metadata")
}

model ApprovalWorkflow {
  id              String   @id
  baseId          String   @map("base_id")
  tableId         String   @map("table_id")
  name            String
  strategy        String
  approverIdsJson String   @map("approver_ids_json")
  threshold       Int?
  expiresInHours  Int?      @map("expires_in_hours")
  createdTime     DateTime @default(now()) @map("created_time")
  updatedTime     DateTime @updatedAt @map("updated_time")

  @@index([baseId, tableId])
  @@map("approval_workflow")
}

model ApprovalRequest {
  id               String    @id
  baseId           String    @map("base_id")
  tableId          String    @map("table_id")
  recordId         String    @map("record_id")
  workflowId       String    @map("workflow_id")
  requesterUserId  String    @map("requester_user_id")
  status           String
  payloadJson      String    @map("payload_json")
  approverIdsJson  String    @map("approver_ids_json")
  expiresAt        DateTime? @map("expires_at")
  createdTime      DateTime  @default(now()) @map("created_time")
  decidedAt        DateTime? @map("decided_at")

  @@index([recordId])
  @@index([workflowId])
  @@map("approval_request")
}

model ApprovalDecision {
  id              String   @id
  requestId       String   @map("request_id")
  approverUserId  String   @map("approver_user_id")
  decision        String
  comment         String?
  createdTime     DateTime @default(now()) @map("created_time")

  @@index([requestId])
  @@map("approval_decision")
}

model FieldExperiment {
  id        String    @id
  baseId    String    @map("base_id")
  tableId   String    @map("table_id")
  fieldId   String    @map("field_id")
  key       String
  status    String
  variants  Json
  salt      String
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([baseId, tableId, fieldId, status])
  @@map("field_experiment")
}

model FieldExperimentAssignment {
  experimentId String   @map("experiment_id")
  recordId     String   @map("record_id")
  variantId    String   @map("variant_id")
  bucket       Float
  assignedAt   DateTime @default(now()) @map("assigned_at")

  @@id([experimentId, recordId])
  @@map("field_experiment_assignment")
}

model FieldExperimentExposure {
  id           String   @id @default(cuid())
  experimentId String   @map("experiment_id")
  assignmentId String   @map("assignment_id")
  recordId     String   @map("record_id")
  variantId    String   @map("variant_id")
  outcome      String?
  value        Float?
  observedAt   DateTime @default(now()) @map("observed_at")

  @@index([experimentId])
  @@map("field_experiment_exposure")
}

model ByokLlmKey {
  id             String   @id
  orgId          String   @map("org_id")
  provider       String
  alias          String
  status         String
  ciphertextRef  String   @map("ciphertext_ref")
  fingerprint    String
  verifiedAt     DateTime? @map("verified_at")
  lastUsedAt     DateTime? @map("last_used_at")
  providerTpmCap Int      @default(0) @map("provider_tpm_cap")
  orgDailyCap    Int      @default(0) @map("org_daily_cap")
  isolation      String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("byok_llm_key")
}

model ByokLlmUsage {
  orgId      String @map("org_id")
  keyId      String @map("key_id")
  provider   String
  day        String
  tokens     BigInt @default(0)
  costCents  BigInt @default(0) @map("cost_cents")
  requests   Int    @default(0)
  errors     Int    @default(0)

  @@id([orgId, keyId, day])
  @@map("byok_llm_usage")
}

model ByokLlmAttempt {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  keyId     String   @map("key_id")
  provider  String
  tokens    BigInt
  costCents BigInt   @map("cost_cents")
  succeeded Boolean
  atIso     DateTime @map("at_iso")
  hash      String

  @@index([orgId, keyId, atIso])
  @@map("byok_llm_attempt")
}

model ScimPushSubscription {
  id            String   @id
  orgId         String   @map("org_id")
  label         String
  endpoint      String
  signingSecret String   @map("signing_secret")
  filter        Json
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("scim_push_subscription")
}

model ScimPushEvent {
  id           String   @id
  orgId        String   @map("org_id")
  kind         String
  subjectId    String   @map("subject_id")
  externalId   String?  @map("external_id")
  payload      Json
  occurredAt   DateTime @map("occurred_at")

  @@index([orgId, occurredAt])
  @@map("scim_push_event")
}

model ScimPushDelivery {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  subscriptionId String   @map("subscription_id")
  status         String
  attempts       Int      @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastStatusCode Int?     @map("last_status_code")
  lastError      String?  @map("last_error")
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([subscriptionId])
  @@map("scim_push_delivery")
}

model WebhookBridge {
  id         String   @id
  baseId     String   @map("base_id")
  name       String
  direction  String
  auth       Json
  target     String
  eventTypes Json?    @map("event_types")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([baseId])
  @@map("webhook_bridge")
}

model SsoProvider {
  id           String   @id
  baseId       String   @map("base_id")
  name         String
  protocol     String
  enabled      Boolean  @default(true)
  autoLink     Boolean  @default(false) @map("auto_link")
  emailDomains Json     @map("email_domains")
  priority     Int      @default(100)
  config       Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([baseId, enabled])
  @@map("sso_provider")
}

model EncryptionKey {
  id         String    @id
  kid        String    @unique
  algorithm  String
  alias      String?
  state      String
  createdTime DateTime @default(now()) @map("created_time")
  retiredAt  DateTime? @map("retired_at")

  @@map("encryption_key")
}

model MaskingPolicy {
  id              String   @id
  baseId          String   @map("base_id")
  tableId         String   @map("table_id")
  fieldId         String   @map("field_id")
  strategy        String
  scope           String
  allowedRolesJson String  @map("allowed_roles_json")
  partialJson     String?  @map("partial_json")
  regexRulesJson  String?  @map("regex_rules_json")
  label           String?
  createdTime     DateTime @default(now()) @map("created_time")
  updatedTime     DateTime @updatedAt @map("updated_time")

  @@index([baseId, tableId, fieldId])
  @@map("masking_policy")
}

model MaskedFieldRow {
  id            String   @id
  baseId        String   @map("base_id")
  tableId       String   @map("table_id")
  recordId      String   @map("record_id")
  fieldId       String   @map("field_id")
  policyId      String   @map("policy_id")
  viewerUserId  String   @map("viewer_user_id")
  createdTime   DateTime @default(now()) @map("created_time")

  @@index([baseId, recordId, createdTime])
  @@map("masked_field_row")
}

model DbConnector {
  id                 String   @id
  baseId             String   @map("base_id")
  name               String
  kind               String
  encryptedConfigJson String  @map("encrypted_config_json")
  incrementalField   String?  @map("incremental_field")
  schedule           String   @default("")
  targetTableId      String   @default("") @map("target_table_id")
  enabled            Boolean  @default(true)
  lastSyncAt         DateTime? @map("last_sync_at")
  createdTime        DateTime @default(now()) @map("created_time")
  updatedTime        DateTime @updatedAt @map("updated_time")

  @@index([baseId])
  @@map("db_connector")
}

model DbConnectorSync {
  id           String    @id
  connectorId  String    @map("connector_id")
  mode         String
  status       String
  rowsFetched  Int       @default(0) @map("rows_fetched")
  rowsWritten  Int       @default(0) @map("rows_written")
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  errorMessage String?   @map("error_message")
  triggeredBy  String    @map("triggered_by")

  @@index([connectorId, startedAt])
  @@map("db_connector_sync")
}

model NotificationDelivery {
  id             String    @id
  notificationId String    @map("notification_id")
  channel        String
  status         String
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  sentAt         DateTime? @map("sent_at")

  @@index([notificationId])
  @@map("notification_delivery")
}

model NotificationPreference {
  userId          String  @id @map("user_id")
  channelsJson    String  @map("channels_json")
  quietHoursStart Int?    @map("quiet_hours_start")
  quietHoursEnd   Int?    @map("quiet_hours_end")

  @@map("notification_preference")
}

model Announcement {
  id             String    @id
  form           String
  level          String
  title          String
  body           String
  linkText       String?   @map("link_text")
  linkUrl        String?   @map("link_url")
  audience       String
  targetIds      Json      @map("target_ids")
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  withdrawnAt    DateTime? @map("withdrawn_at")
  createdBy      String    @map("created_by")
  createdTime    DateTime  @default(now()) @map("created_time")
  lastModifiedAt DateTime? @updatedAt @map("last_modified_at")

  dismissals AnnouncementDismissal[]

  @@index([startsAt, endsAt, withdrawnAt])
  @@index([createdTime])
  @@map("announcement")
}

model AnnouncementDismissal {
  id             String       @id
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  dismissedAt    DateTime     @default(now()) @map("dismissed_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, dismissedAt])
  @@map("announcement_dismissal")
}

model PresenceSession {
  id              String   @id
  baseId          String   @map("base_id")
  scope           String
  scopeId         String   @map("scope_id")
  userId          String   @map("user_id")
  color           String
  displayName     String   @map("display_name")
  status          String
  cursorJson      String?  @map("cursor_json")
  lastHeartbeatAt DateTime @map("last_heartbeat_at")
  expiresAt       DateTime @map("expires_at")
  connectedAt     DateTime @map("connected_at")

  @@index([baseId, scope, scopeId])
  @@index([expiresAt])
  @@map("presence_session")
}

model OrgQuotaEnvelope {
  orgId         String  @id @map("org_id")
  caps          Json
  policy        String
  softFraction  Float   @map("soft_fraction")
  windowSeconds Int?    @map("window_seconds")
  notes         String?

  @@map("org_quota_envelope")
}

model OrgQuotaFairness {
  orgId          String @id @map("org_id")
  deficits       Json
  lastGrantByBase Json   @map("last_grant_by_base")
