// ─────────────────────────────────────────────────────────────────────────────
// Quota / SLA subsystem (Self-Host Business parity, OSS-friendly defaults)
//
// Goals:
//   - Track per-space hard limits for rows, attachment bytes, automation runs,
//     AI credits and storage-derived counters; matches Teable.ai Cloud plans.
//   - Track rolling usage counters (current period + lifetime) so enforcement
//     and dashboards share a single source of truth.
//   - Record quota hits for analytics and self-hosted admin review.
//   - Self-host installs default to unlimited (`-1`); Cloud / Pro / Business
//     plans populate concrete limits via `setPlanLimits`.
//
// NOTE: kept additive only — never drop or rename; quota history powers audit
//       and is retained even when limits are relaxed.
// ─────────────────────────────────────────────────────────────────────────────

enum PlanLevel {
  free
  pro
  business
  enterprise
  self_hosted
}

enum QuotaMetric {
  rows
  attachment_bytes
  automation_runs
  ai_credits
  api_requests
  record_history_days
  automation_history_days
  seats
}

model SpaceQuota {
  id                    String    @id @default(cuid())
  spaceId               String    @unique @map("space_id")
  plan                  PlanLevel @default(free)
  // -1 = unlimited (self-host default); >=0 = enforced hard cap.
  rowLimit              Int?      @map("row_limit")
  attachmentByteLimit   BigInt?   @map("attachment_byte_limit")
  automationRunLimit    Int?      @map("automation_run_limit")
  aiCreditLimit         Int?      @map("ai_credit_limit")
  apiRequestLimitPerSec Int?      @map("api_request_limit_per_sec")
  recordHistoryDays     Int?      @map("record_history_days")
  automationHistoryDays Int?      @map("automation_history_days")
  seatLimit             Int?      @map("seat_limit")
  // bumped add-on packs (cloud-only invoice model; informational on self-host)
  rowAddon              Int?      @map("row_addon")
  automationAddon       Int?      @map("automation_addon")
  aiCreditAddon         Int?      @map("ai_credit_addon")
  attachmentByteAddon   BigInt?   @map("attachment_byte_addon")
  effectiveFrom         DateTime  @default(now()) @map("effective_from")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  updatedBy             String?   @map("updated_by")

  @@map("space_quota")
}

// One row per (spaceId, metric, periodStart). Periods are calendar months in
// UTC; we never mutate historical rows — counters only advance.
model SpaceUsageCounter {
  id          BigInt      @id @default(autoincrement())
  spaceId     String      @map("space_id")
  metric      QuotaMetric @map("metric")
  periodStart DateTime    @map("period_start") @db.Date
  periodKind  String      @default("monthly") @map("period_kind") @db.VarChar(16)
  used        BigInt      @default(0)
  // Cached snapshot of the cap in force at period start; lets dashboards show
  // "1000 / 25000" even if the cap changed mid-period.
  capSnapshot BigInt?     @map("cap_snapshot")
  lastEventAt DateTime    @default(now()) @map("last_event_at")
  createdTime DateTime    @default(now()) @map("created_time")

  @@unique([spaceId, metric, periodKind, periodStart])
  @@index([spaceId, metric])
  @@index([periodStart])
  @@map("space_usage_counter")
}

// Soft log of every enforcement rejection. Persisted only when enforcement is
// active (i.e. cap != -1). Audit dashboard / admin panel read from here.
model QuotaHit {
  id          BigInt      @id @default(autoincrement())
  spaceId     String      @map("space_id")
  metric      QuotaMetric @map("metric")
  attempted   BigInt      @map("attempted")
  cap         BigInt      @map("cap")
  actorId     String?     @map("actor_id")
  resource    String?     @map("resource") // e.g. "table:abc", "automation:xyz"
  createdTime DateTime    @default(now()) @map("created_time")

  @@index([spaceId, metric, createdTime])
  @@map("quota_hit")
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain verification — minimal scaffolding shared by SSO + custom app domain.
//
// Owner claims ownership of a domain by adding a Teable-issued TXT record;
// we poll DNS to confirm. Once verified, downstream flows can:
//   - bind SSO for the org (only members whose email matches the domain
//     get auto-provisioned)
//   - point a custom app subdomain (e.g. `crm.acme.com`) at a published
//     App via the reverse proxy (`teable-gateway`).
//
// Self-host OSS ships the API + state machine. DNS resolution uses Node's
// built-in `dns/promises` so we don't add a new runtime dependency.
// ─────────────────────────────────────────────────────────────────────────────

enum DomainVerificationStatus {
  pending
  verified
  failed
  revoked
}

enum SsoProviderType {
  oidc
  // saml reserved for a later stage; type is here so the column doesn't
  // need a destructive migration when SAML lands.
  saml
}

enum SsoConnectionStatus {
  pending
  active
  disabled
  failed
}

model OrganizationDomain {
  id                String                   @id @default(cuid())
  // The org that owns this domain (single-tenant self-host = 1 org).
  organizationId    String                   @map("organization_id")
  domain            String                   @unique
  // Token the operator must publish as `_teable-verify.<domain>` TXT.
  verificationToken String                   @unique @map("verification_token") @db.VarChar(64)
  status            DomainVerificationStatus @default(pending)
  lastCheckedAt     DateTime?                @map("last_checked_at")
  lastError         String?                  @map("last_error")
  // When the org downgrades / revokes the claim, set this and reset status.
  revokedAt         DateTime?                @map("revoked_at")
  // For SSO auto-provisioning: once verified, all emails matching `domain`
  // are eligible for the org without an explicit invite.
  ssoBound          Boolean                  @default(false) @map("sso_bound")
  // For custom app domains: which app id the CNAME points at.
  boundAppId        String?                  @map("bound_app_id")
  createdBy         String                   @map("created_by")
  createdTime       DateTime                 @default(now()) @map("created_time")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("organization_domain")
}

model SsoIdentityProvider {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  // Display name shown to admins; not user-visible.
  name           String
  // Which OIDC issuer this IdP serves. Used to discover endpoints + JWKS.
  // SAML providers populate this with their entityID for parity.
  issuer         String
  // OIDC client credentials registered with the IdP. SAML uses different
  // fields; left nullable so a future SAML row can omit them.
  clientId       String?             @map("client_id")
  clientSecret   String?             @map("client_secret")
  // Optional discovery URL override; when null we use `${issuer}/.well-known/openid-configuration`.
  discoveryUrl   String?             @map("discovery_url")
  // Email domain this IdP handles — must match a verified OrganizationDomain row.
  emailDomain    String              @map("email_domain")
  type           SsoProviderType     @default(oidc)
  status         SsoConnectionStatus @default(pending)
  // Last discovery / JWKS fetch result, for admin debugging.
  lastError      String?             @map("last_error")
  lastCheckedAt  DateTime?           @map("last_checked_at")
  createdBy      String              @map("created_by")
  createdTime    DateTime            @default(now()) @map("created_time")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([organizationId, emailDomain])
  @@index([issuer])
  @@index([status])
  @@map("sso_identity_provider")
}

model SsoLoginState {
  // Short-lived (5 min) state token for CSRF protection on the callback.
  // Stored server-side so we can correlate the IdP redirect back to the
  // original request without trusting the cookie / query string alone.
  id             String   @id @default(cuid())
  state          String   @unique
  organizationId String   @map("organization_id")
  providerId     String   @map("provider_id")
  // Email the user claimed to log in as; used for the post-auth user match.
  emailHint      String?  @map("email_hint")
  // Redirect target after success — typically the dashboard or invitation link.
  redirectTo     String?  @map("redirect_to")
  // Bumped on every retry so old links stop working once consumed.
  consumed       Boolean  @default(false)
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("sso_login_state")
}

enum PermissionRoleStatus {
  enabled
  disabled
}

enum PermissionNodeAccess {
  // No access to the table at all; UI should hide it.
  none
  // Read/write access to the table subject to record + field filters.
  editable
}

enum PermissionFieldAccess {
  // Field hidden from this role (returns null + UI grays it out).
  hidden
  // Read-only; mutations throw on this field.
  readonly
  // Full CRUD on this field.
  editable
}

enum PermissionRecordAction {
  view
  update
  create
  delete
  comment
}

// JSON-encoded filter graph (subset of the public filter DSL). Kept
// portable as `Json` so future operators don't require schema migration.
model PermissionRoleRecordFilter {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  tableId   String   @map("table_id")
  // The shape mirrors `IRecordFilter` from openapi but stored as JSON so
  // we don't have to migrate the schema when the filter DSL evolves.
  filter    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role PermissionRole @relation("PermissionRoleRecordFilterToPermissionRole", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, tableId])
  @@map("permission_role_record_filter")
}

model PermissionRoleFieldPermission {
  id        String                @id @default(cuid())
  roleId    String                @map("role_id")
  tableId   String                @map("table_id")
  fieldId   String                @map("field_id")
  access    PermissionFieldAccess
  createdAt DateTime              @default(now()) @map("created_at")

  role PermissionRole @relation("PermissionRoleFieldPermissionToPermissionRole", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, fieldId])
  @@map("permission_role_field_permission")
}

model PermissionRoleRecordAction {
  id        String                 @id @default(cuid())
  roleId    String                 @map("role_id")
  tableId   String                 @map("table_id")
  action    PermissionRecordAction
  createdAt DateTime               @default(now()) @map("created_at")

  role PermissionRole @relation("PermissionRoleRecordActionToPermissionRole", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, tableId, action])
  @@map("permission_role_record_action")
}

model PermissionRoleNode {
  id        String               @id @default(cuid())
  roleId    String               @map("role_id")
  tableId   String               @map("table_id")
  access    PermissionNodeAccess
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  role PermissionRole @relation("PermissionRoleNodeToPermissionRole", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, tableId])
  @@map("permission_role_node")
}

model PermissionRoleMember {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  role PermissionRole @relation("PermissionRoleMemberToPermissionRole", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@map("permission_role_member")
}

model PermissionRole {
  id          String               @id @default(cuid())
  baseId      String               @map("base_id")
  // Human-readable label shown in the admin UI.
  name        String
  description String?
  status      PermissionRoleStatus @default(enabled)
  createdBy   String               @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  members       PermissionRoleMember[]          @relation("PermissionRoleMemberToPermissionRole")
  nodes         PermissionRoleNode[]            @relation("PermissionRoleNodeToPermissionRole")
  fieldPerms    PermissionRoleFieldPermission[] @relation("PermissionRoleFieldPermissionToPermissionRole")
  recordActions PermissionRoleRecordAction[]    @relation("PermissionRoleRecordActionToPermissionRole")
  recordFilters PermissionRoleRecordFilter[]    @relation("PermissionRoleRecordFilterToPermissionRole")

  @@unique([baseId, name])
  @@index([baseId])
  @@map("permission_role")
}

// Stage 13 — Automation engine MVP
enum AutomationTriggerType {
  record_created
  record_updated
  record_deleted
  schedule

  @@map("AutomationTriggerType")
}

enum AutomationActionType {
  update_record
  webhook
  email
  slack
  discord
  telegram

  @@map("AutomationActionType")
}

enum AutomationRunStatus {
  pending
  running
  succeeded
  failed
  skipped

  @@map("AutomationRunStatus")
}

model Automation {
  id               String    @id @default(cuid())
  baseId           String    @map("base_id")
  name             String
  description      String?
  enabled          Boolean   @default(true)
  createdBy        String    @map("created_by")
  createdTime      DateTime  @default(now()) @map("created_time")
  lastModifiedBy   String?   @map("last_modified_by")
  lastModifiedTime DateTime? @updatedAt @map("last_modified_time")

  triggers AutomationTrigger[]
  actions  AutomationAction[]
  runs     AutomationRun[]

  @@index([baseId])
  @@map("automation")
}

model AutomationTrigger {
  id           String                @id @default(cuid())
  automationId String                @map("automation_id")
  type         AutomationTriggerType
  tableId      String?               @map("table_id")
  config       Json                  @default("{}")
  createdTime  DateTime              @default(now()) @map("created_time")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([type])
  @@map("automation_trigger")
}

model AutomationAction {
  id           String               @id @default(cuid())
  automationId String               @map("automation_id")
  type         AutomationActionType
  orderIndex   Int                  @default(0) @map("order_index")
  config       Json                 @default("{}")
  createdTime  DateTime             @default(now()) @map("created_time")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_action")
}

model AutomationRun {
  id           String                @id @default(cuid())
  automationId String                @map("automation_id")
  triggerType  AutomationTriggerType @map("trigger_type")
  status       AutomationRunStatus   @default(pending)
  input        Json                  @default("{}")
  output       Json?
  error        String?
  retryCount   Int                   @default(0) @map("retry_count")
  startedAt    DateTime?             @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  createdTime  DateTime              @default(now()) @map("created_time")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([status])
  @@index([createdTime])
  @@map("automation_run")
}

// Stage 16 — OAuth 2.0 server (RFC 6749 + PKCE / RFC 7636)
// Independent gap-fill for OSS Business+ parity. The pre-existing
// oauth_app_* tables are kept untouched for backward compatibility;
// these new tables cover the authorization_code + refresh_token + PKCE
// surface that third-party integrations actually need.

model OAuthApplication {
  id               String   @id
  clientId         String   @unique @map("client_id")
  clientSecretHash String   @map("client_secret_hash")
  name             String
  redirectUris     String[] @map("redirect_uris")
  scopes           String[]
  createdBy        String   @map("created_by")
  createdTime      DateTime @default(now()) @map("created_time")
  lastModifiedTime DateTime @default(now()) @map("last_modified_time")

  codes  OAuthAuthorizationCode[]
  tokens OAuthAccessToken[]

  @@index([createdBy])
  @@map("oauth_application")
}

model OAuthAuthorizationCode {
  id                  String    @id
  codeHash            String    @unique @map("code_hash")
  applicationId       String    @map("application_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri")
  scope               String
  codeChallenge       String?   @map("code_challenge")
  codeChallengeMethod String?   @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdTime         DateTime  @default(now()) @map("created_time")

  application OAuthApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_authorization_code")
}

model OAuthAccessToken {
  id               String    @id
  tokenHash        String    @unique @map("token_hash")
  refreshHash      String?   @unique @map("refresh_hash")
  applicationId    String    @map("application_id")
  userId           String    @map("user_id")
  scope            String
  expiresAt        DateTime  @map("expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdTime      DateTime  @default(now()) @map("created_time")

  application OAuthApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_access_token")
}

// Stage 17 — view-level permission (ACL on top of views)
// Each row grants one subject (user or role) a permission on a view.
// 'owner' / 'write' / 'read' / 'denied' (overrides everything).
model ViewPermission {
  id               String   @id
  viewId           String   @map("view_id")
  subjectKind      String   @map("subject_kind")
  subjectId        String   @map("subject_id")
  permission       String
  createdTime      DateTime @default(now()) @map("created_time")
  lastModifiedTime DateTime @default(now()) @map("last_modified_time")

  @@unique([viewId, subjectKind, subjectId])
  @@index([viewId])
  @@index([subjectKind, subjectId])
  @@map("view_permission")
}

// Stage 18 — conditional formatting (per-view rules)
// `style` is JSON; supports {bgColor, fgColor, bold, italic, icon}.
// `value` is the right-hand side of the operator comparison; for
// operator in 'in' it is a JSON array.
model ConditionalFormatRule {
  id               String   @id
  viewId           String   @map("view_id")
  name             String
  fieldId          String?  @map("field_id")
  operator         String
  value            Json?
  style            Json
  priority         Int      @default(100)
  enabled          Boolean  @default(true)
  createdTime      DateTime @default(now()) @map("created_time")
  lastModifiedTime DateTime @default(now()) @map("last_modified_time")

  @@index([viewId, priority])
  @@index([viewId, fieldId])
  @@map("conditional_format_rule")
}

// Stage 20 — backup / restore
// `manifest` carries the table list + record counts captured at backup
// time, so listing doesn't need to re-open the archive file.
model BackupSnapshot {
  id               String             @id
  baseId           String             @map("base_id")
  createdBy        String             @map("created_by")
  status           BackupStatus
  sizeBytes        BigInt             @default(0) @map("size_bytes")
  archivePath      String             @map("archive_path")
  manifest         Json?
  errorMessage     String?            @map("error_message")
  createdTime      DateTime           @default(now()) @map("created_time")
  lastModifiedTime DateTime           @default(now()) @map("last_modified_time")
  restoreLogs      BackupRestoreLog[]

  @@index([baseId, createdTime])
  @@index([status])
  @@map("backup_snapshot")
}

enum BackupStatus {
  pending
  complete
  failed
}

model BackupRestoreLog {
  id           String        @id
  snapshotId   String        @map("snapshot_id")
  targetBaseId String        @map("target_base_id")
  status       RestoreStatus
  startedTime  DateTime?     @map("started_time")
  finishedTime DateTime?     @map("finished_time")
  rowsRestored Int           @default(0) @map("rows_restored")
  errorMessage String?       @map("error_message")
  createdTime  DateTime      @default(now()) @map("created_time")

  snapshot BackupSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, createdTime])
  @@index([status])
  @@map("backup_restore_log")
}

enum RestoreStatus {
  queued
  running
  complete
  failed
}

// Stage 22 — TOTP two-factor factors. One row per enabled factor
// (a user may have multiple: e.g. an authenticator app + a hardware
// token registered later). `secret` is the base32-encoded shared
// secret; we never store the user's current/recovery state.
model UserTotpFactor {
  id          String   @id
  userId      String   @map("user_id")
  // Friendly label shown in the user's security settings ("iPhone", "YubiKey 5").
  label       String
  // base32 shared secret. At least 20 chars per RFC 4226 §4.
  secret      String   @map("secret")
  // Algorithm + digits + period — pinned at enrollment so later
  // changes to defaults don't invalidate existing factors.
  algorithm   String   @default("SHA1") @map("algorithm")
  digits      Int      @default(6) @map("digits")
  period      Int      @default(30) @map("period")
  // Last accepted counter, used to prevent replay within a window.
  lastCounter BigInt   @default(0) @map("last_counter")
  enabled     Boolean  @default(true) @map("enabled")
  createdTime DateTime @default(now()) @map("created_time")

  backupCodes UserTotpBackupCode[]

  @@index([userId])
  @@map("user_totp_factor")
}

// Stage 22 — single-use backup codes. Hashed at rest (SHA-256 of
// the normalized lowercase code); the plaintext is shown once at
// enrollment and never recoverable.
model UserTotpBackupCode {
  id          String    @id
  factorId    String    @map("factor_id")
  // Lowercase hex digest of the code. The plaintext column is gone
  // the moment enrollment returns the codes to the user.
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at")
  createdTime DateTime  @default(now()) @map("created_time")

  factor UserTotpFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@index([factorId])
  @@map("user_totp_backup_code")
}

// Stage 23 — SCIM 2.0 bearer tokens. Operators create a token per
// IdP integration (Okta, Azure AD, Google Workspace…). Tokens are
// presented as `Authorization: Bearer <token>`; we hash at rest so a
// leaked DB row can't be used to talk to SCIM endpoints.
model ScimToken {
  id             String    @id
  organizationId String    @map("organization_id")
  // Friendly label shown in admin UI ("Okta production").
  label          String
  // sha256 of the plaintext bearer token; never the token itself.
  tokenHash      String    @unique @map("token_hash")
  // Optional last-4 prefix, shown in the UI so operators can spot
  // which token was used in an audit log.
  tokenPrefix    String?   @map("token_prefix")
  enabled        Boolean   @default(true) @map("enabled")
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  createdBy      String    @map("created_by")
  createdTime    DateTime  @default(now()) @map("created_time")

  @@index([organizationId, enabled])
  @@map("scim_token")
}

// Stage 23 — inbound SCIM event log (audit-friendly). Each accepted
// IdP request creates one row that an admin can replay later for
// forensics.
model ScimEvent {
  id             String   @id
  organizationId String   @map("organization_id")
  tokenId        String   @map("token_id")
  // "create_user" / "update_user" / "delete_user" / "create_group" …
  action         String
  // The externalId from the SCIM payload — operator-facing handle.
  externalId     String?  @map("external_id")
  // Local userId / groupId we resolved to (null on no-op).
  targetId       String?  @map("target_id")
  requestJson    Json     @map("request_json")
  statusCode     Int      @map("status_code")
  createdTime    DateTime @default(now()) @map("created_time")

  @@index([organizationId, createdTime])
  @@index([tokenId])
  @@map("scim_event")
}

// Stage 24 — durable audit event store. The audit decorator already
// fans out to an in-memory sink; we add a persisted table so events
// survive restarts and can be exported / forwarded.
model AuditEvent {
  id             String   @id
  organizationId String?  @map("organization_id")
  actorId        String?  @map("actor_id")
  // "user.login" / "record.create" / "sso.start" — stable verb-noun.
  action         String
  // Free-form structured detail (resource id, ip, etc).
  detail         Json?
  // IP captured at the boundary; null for system events.
  ipAddress      String?  @map("ip_address")
  // Optional request id for tracing.
  requestId      String?  @map("request_id")
  createdTime    DateTime @default(now()) @map("created_time")

  @@index([organizationId, createdTime])
  @@index([action, createdTime])
  @@index([actorId, createdTime])
  @@map("audit_event")
}

// Stage 24 — outbound SIEM webhook subscriptions. Operators paste a
// URL + a shared HMAC secret; events are batched and POSTed.
model SiemWebhook {
  id              String    @id
  organizationId  String    @map("organization_id")
  label           String
  url             String
  // Shared HMAC-SHA256 secret for the `X-Teable-Signature` header.
  secret          String    @map("secret")
  enabled         Boolean   @default(true) @map("enabled")
  // Only forward events whose action matches one of these. Empty = all.
  actions         String[]  @map("actions")
  lastDeliveredAt DateTime? @map("last_delivered_at")
  lastErrorAt     DateTime? @map("last_error_at")
  lastError       String?   @map("last_error")
  createdBy       String    @map("created_by")
  createdTime     DateTime  @default(now()) @map("created_time")

  @@index([organizationId, enabled])
  @@map("siem_webhook")
}

// Stage 25 — operator-managed IP allowlist. CIDR strings (IPv4 +
// IPv6). An org with rows here rejects every request whose remote
// address doesn't match an entry. "Block mode" (default) is the
// production posture; "audit-only" mirrors to the audit log but
// doesn't reject (useful for rolling out).
model OrganizationIpAllowlist {
  id             String   @id
  organizationId String   @map("organization_id")
  cidr           String   @map("cidr")
  // "block" or "audit".
  mode           String   @default("block") @map("mode")
  note           String?
  createdBy      String   @map("created_by")
  createdTime    DateTime @default(now()) @map("created_time")

  @@index([organizationId])
  @@map("organization_ip_allowlist")
}

// Stage 26 — AI credit ledger. One row per credit-affecting event
// (charge / refund / grant). `monthBucket` is a YYYY-MM string so the
// monthly rollup is a single index range scan.
model AiCreditLedger {
  id             String   @id
  organizationId String   @map("organization_id")
  // "charge" / "refund" / "grant". Positive deltas add credits; charges add 0.
  action         String
  // Tokens or credits consumed (for "charge") or restored (for "refund" / "grant").
  credits        Int      @map("credits")
  // "openai" / "anthropic" / "internal" — provider name; used for cost dashboards.
  provider       String?
  // Stable handle to the upstream event — an automation id, an AI run id, etc.
  sourceRef      String?  @map("source_ref")
  // YYYY-MM. Denormalized so rollups are index-only.
  monthBucket    String   @map("month_bucket")
  createdTime    DateTime @default(now()) @map("created_time")

  @@index([organizationId, monthBucket])
  @@index([organizationId, createdTime])
  @@map("ai_credit_ledger")
}

model WorkspaceSwitchSession {
  id          String    @id
  userId      String    @map("user_id")
  fromSpaceId String?   @map("from_space_id")
  toSpaceId   String    @map("to_space_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdTime DateTime  @default(now()) @map("created_time")

  @@index([userId])
  @@index([token])
  @@map("workspace_switch_session")
}

model CrossOrgAdminGrant {
