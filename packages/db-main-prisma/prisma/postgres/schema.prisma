// Cloud §AI §App Builder (help.teable.ai/en/basic/ai/app-builder).
// "Transform your data into custom web applications using AI."
// Minimal R-AI-4 surface: 11 HTTP endpoints covering CRUD + deploy +
// rollback + versions + secrets (write-only) + files. Real LLM-driven
// generation lives in the existing ai-builder module (proposals).
model AppInstance {
  id           String   @id @default(cuid())
  baseId       String   @map("base_id")
  name         String
  description  String?
  currentVersionId String? @unique @map("current_version_id")
  status       String   @default("draft")
  /// Round 45: globally-unique 12-char base36 slug for the public URL.
  /// Null when the app is unpublished. We index it (partial unique)
  /// so the runtime endpoint can resolve `GET /a/<slug>` in O(log n).
  publicSlug   String?  @unique @map("public_slug")
  /// Round 45: wall-clock at which the app was last published. Cleared
  /// on unpublish. Used for cache invalidation and "last deployed" UI.
  publishedAt  DateTime? @map("published_at")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  base       Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  versions   AppVersion[]     @relation("AppVersionToAppInstance")
  currentVersion AppVersion? @relation("AppInstanceCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  secrets    AppSecret[]      @relation("AppSecretToAppInstance")
  files      AppFile[]        @relation("AppFileToAppInstance")

  @@unique([baseId, name])
  @@index([baseId])
  @@index([publicSlug])
  @@map("app_instance")
}

model AppVersion {
  id            String   @id @default(cuid())
  appId         String   @map("app_id")
  versionNumber Int      @map("version_number")
  snapshot      Json
  sourcePrompt  String?  @map("source_prompt")
  status        String   @default("draft")
  deployedAt    DateTime? @map("deployed_at")
  deployedBy    String?  @map("deployed_by")
  createdAt     DateTime @default(now()) @map("created_at")

  app      AppInstance @relation("AppVersionToAppInstance", fields: [appId], references: [id], onDelete: Cascade)
  currentOf AppInstance? @relation("AppInstanceCurrentVersion")

  @@unique([appId, versionNumber])
  @@index([appId])
  @@map("app_version")
}

// Secret values are stored encrypted in meta.app_secret.value_ciphertext;
// the value is write-only (the GET endpoint returns key + meta only, never
// the plaintext, matching Cloud's "Secret values are write-only after saving").
model AppSecret {
  id              String   @id @default(cuid())
  appId           String   @map("app_id")
  key             String
  valueCiphertext String   @map("value_ciphertext")
  description     String?
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  app AppInstance @relation("AppSecretToAppInstance", fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, key])
  @@index([appId])
  @@map("app_secret")
}

model AppFile {
  id        String   @id @default(cuid())
  appId     String   @map("app_id")
  path      String
  content   String   @default("")
  sizeBytes Int      @default(0) @map("size_bytes")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  app AppInstance @relation("AppFileToAppInstance", fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, path])
  @@index([appId])
  @@map("app_file")
}

enum AppStatus {
  draft
  deployed
  archived

  @@map("app_status")
}

enum AppVersionStatus {
  draft
  deployed
  rolled_back

  @@map("app_version_status")
}

// ─── AI Chat (Cloud §ai/ai-chat) ─────────────────────────────────
model AiChatSession {
  id          String   @id
  baseId      String?  @map("base_id")
  tableId     String?  @map("table_id")
  viewId      String?  @map("view_id")
  title       String?
  model       String?
  smartLevel  String?  @map("smart_level")
  tokenBudget Int?     @map("token_budget")
  allowedTools Json?   @map("allowed_tools")
  createdBy   String   @map("created_by")
  createdTime DateTime @default(now()) @map("created_time")
  updatedTime DateTime @updatedAt @map("updated_time")

  messages AiChatMessage[]
  longTasks AiChatLongTask[]
  artifacts AiChatArtifact[]
  queuedMessages AiChatQueuedMessage[]
  writePlans AiChatWritePlan[]
  nodeRefs  AiChatNodeRef[]
  selectionRefs AiChatSelectionRef[]

  @@index([baseId, createdTime])
  @@index([createdBy, createdTime])
  @@map("ai_chat_session")
}

model AiChatMessage {
  id          String   @id
  sessionId   String   @map("session_id")
  /// "user" | "assistant" | "system"
  role        String
  content     String
  model       String?
  promptTokens Int    @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")
  durationMs  Int      @default(0) @map("duration_ms")
  createdTime DateTime @default(now()) @map("created_time")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  longTask AiChatLongTask?

  @@index([sessionId, createdTime])
  @@map("ai_chat_message")
}

/// Stage 49 — Cloud §ai/ai-chat long-running tasks (24h background execution).
/// Stores the LLM-driven progress of a long task separate from the per-turn
/// message stream so the UI can poll status independently.
model AiChatLongTask {
  id           String   @id
  sessionId    String   @map("session_id")
  userMessageId String  @unique @map("user_message_id")
  /// "queued" | "running" | "succeeded" | "failed" | "canceled"
  /// "pending" and "completed" are accepted while old rows are migrated.
  status       String   @default("queued")
  progress     Int      @default(0)
  result       String?
  errorMessage String?  @map("error_message")
  errorCode    String?  @map("error_code")
  idempotencyKey String? @map("idempotency_key")
  attempt      Int      @default(0)
  maxAttempts  Int      @default(3) @map("max_attempts")
  heartbeatAt  DateTime? @map("heartbeat_at")
  leaseUntil   DateTime? @map("lease_until")
  retryAt      DateTime? @map("retry_at")
  cancelRequested Boolean @default(false) @map("cancel_requested")
  tenantId     String?  @map("tenant_id")
  correlationId String? @map("correlation_id")
  context      String?
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdTime  DateTime @default(now()) @map("created_time")
  updatedTime  DateTime @updatedAt @map("updated_time")

  session    AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userMessage AiChatMessage @relation(fields: [userMessageId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, createdTime])
  @@index([status, leaseUntil])
  @@unique([sessionId, idempotencyKey])
  @@map("ai_chat_long_task")
}

/// Stage 50 — Cloud §ai/ai-chat Artifact: persistent AI-generated output
/// (charts, reports, HTML pages) shown as a card in the conversation and
/// available in an independent viewer even after the chat is closed.
model AiChatArtifact {
  id           String   @id
  sessionId    String   @map("session_id")
  messageId    String?  @map("message_id")
  /// "markdown" | "html" | "chart" | "table" | "mermaid"
  format       String   @default("markdown")
  title        String
  content      String
  version      Int      @default(1)
  createdTime  DateTime @default(now()) @map("created_time")
  updatedTime  DateTime @updatedAt @map("updated_time")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdTime])
  @@index([format])
  @@map("ai_chat_artifact")
}

/// Stage 60 — Cloud §ai/ai-chat message queue: messages a user sent while
/// AI was busy. Processed in `position` order after the current turn
/// completes; users can cancel or reorder them before they run.
model AiChatQueuedMessage {
  id           String   @id
  sessionId    String   @map("session_id")
  userMessage  String   @map("user_message")
  position     Int      @default(0)
  /// "pending" | "processing" | "done" | "cancelled"
  status       String   @default("pending")
  resultMessageId String? @map("result_message_id")
  errorMessage String?  @map("error_message")
  createdTime  DateTime @default(now()) @map("created_time")
  updatedTime  DateTime @updatedAt @map("updated_time")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, position])
  @@map("ai_chat_queued_message")
}

/// Cloud parity boundary for AI-assisted data writes. A plan is immutable from
/// the caller's perspective until it is explicitly confirmed and executed.
model AiChatWritePlan {
  id            String   @id
  sessionId     String   @map("session_id")
  userId        String   @map("user_id")
  baseId        String   @map("base_id")
  tableId       String   @map("table_id")
  /// "record_create" | "record_update"
  operation     String
  payload       Json
  summary       String
  /// "pending" | "confirmed" | "executing" | "executed" | "failed" | "rejected" | "expired"
  status        String   @default("pending")
  expiresAt     DateTime @map("expires_at")
  confirmedBy   String?  @map("confirmed_by")
  confirmedTime DateTime? @map("confirmed_time")
  executedTime  DateTime? @map("executed_time")
  result        Json?
  errorMessage  String?  @map("error_message")
  createdTime   DateTime @default(now()) @map("created_time")
  updatedTime   DateTime @updatedAt @map("updated_time")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdTime])
  @@index([userId, status, expiresAt])
  @@index([tableId, status])
  @@map("ai_chat_write_plan")
}

/// Persistent, permission-checked @ references attached to an AI Chat session.
/// Labels are canonicalized server-side and are never trusted from the client.
model AiChatNodeRef {
  id          String   @id
  sessionId   String   @map("session_id")
  kind        String
  refId       String   @map("ref_id")
  label       String
  createdBy   String   @map("created_by")
  createdTime DateTime @default(now()) @map("created_time")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, kind, refId])
  @@index([sessionId, createdTime])
  @@index([refId, kind])
  @@map("ai_chat_node_ref")
}

/// V81 R-CHAT-1 — Persistent, permission-checked Grid selection chips
/// attached to an AI Chat session. Carries the rendered row/column/cell/range
/// selection so the chat prompt can reference it deterministically.
model AiChatSelectionRef {
  id            String   @id
  sessionId     String   @map("session_id")
  tableId       String   @map("table_id")
  viewId        String?  @map("view_id")
  selectionType String   @map("selection_type")
  refKey        String   @map("ref_key")
  refValue      Json     @map("ref_value")
  displayLabel  String   @map("display_label")
  rowCount      Int?     @map("row_count")
  createdBy     String   @map("created_by")
  createdTime   DateTime @default(now()) @map("created_time")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, refKey])
  @@index([sessionId, createdTime])
  @@index([sessionId, tableId])
  @@map("ai_chat_selection_ref")
}
