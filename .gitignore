# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# and https://github.com/github/gitignore for examples

# local env files (followinf dotenv-flow / nextjs convention)

.env.local
.env.*.local
# Local runtime configuration is not source code. Keep the checked-in
# examples available while ignoring newly created instance-specific files.
**/.env
**/.env.*
!**/.env.example
!**/.env.test

# security: atlassian/changeset

**/.netrc

# dependencies
node_modules
.pnpm-store/
.pnp.*

# testing
/coverage
.out/

# Debug

**/.debug

# Build directories (next.js...)
/.next/
/out/
/build
/dist/
**/.next/
**/out/
**/build/
**/dist/

# v2 packages build output
packages/v2/**/dist/

# TypeScript compiler output emitted beside source files by local builds.
# Keep hand-authored TypeScript and static assets visible to git.
packages/core/src/**/*.js
packages/core/src/**/*.js.map
packages/core/src/**/*.d.ts
packages/formula/src/**/*.js
packages/formula/src/**/*.js.map
packages/formula/src/**/*.d.ts
packages/openapi/src/**/*.js
packages/openapi/src/**/*.js.map
packages/openapi/src/**/*.d.ts
packages/db-data-prisma/src/**/*.js
packages/db-data-prisma/src/**/*.js.map
packages/db-data-prisma/src/**/*.d.ts
packages/db-main-prisma/src/**/*.js
packages/db-main-prisma/src/**/*.js.map
packages/db-main-prisma/src/**/*.d.ts
packages/i18n-keys/src/**/*.js
packages/i18n-keys/src/**/*.js.map
packages/i18n-keys/src/**/*.d.ts
packages/v2/**/src/**/*.js
packages/v2/**/src/**/*.js.map
packages/v2/**/src/**/*.d.ts

# Next.js auto-generated type definitions
**/next-env.d.ts

# Cache
*.tsbuildinfo
**/.eslintcache
.cache/*
.swc/
apps/playground/src/routeTree.gen.ts

# Misc
.DS_Store
*.pem
.worktrees/

# Debug
npm-debug.log*
pnpm-debug.log*


# IDE
**/.idea/*
!**/.idea/modules.xml
!**/.idea/*.iml
.project
.classpath
*.launch
*.sublime-workspace

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Docker overrides

./docker-compose.override.yml

# Deployment platforms

.vercel

# LocalStorage assets

**/.assets

# Generated local/static runtime assets.
**/static/plugin/
**/static/system/
**/static/test/

# Runtime-generated i18n declaration when commands run from the repository root.
/src/types/i18n.generated.ts

# Sandbox Agent / runtime artefacts that should never be tracked
/apps/nestjs-backend/dist/
/apps/nextjs-app/.next/
/apps/nextjs-app/out/
/coverage/
/.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo
.pnpm-debug.log*

# Local-only runtime config files generated by docker / startup scripts
/docker/.env
/docker/**/.env
/docker-compose.local.yml
