TIMEZONE=UTC

# PostgreSQL Env
POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=teable

# Redis env
REDIS_PASSWORD=teable

# Teable app env (passed into the container via env_file)
PRISMA_DATABASE_URL=postgresql://teable:teable@teable-db:5432/teable?schema=public&statement_cache_size=1
PRISMA_META_DATABASE_URL=postgresql://teable:teable@teable-db:5432/teable?schema=meta&statement_cache_size=1
REDIS_URL=redis://:teable@teable-cache:6379/0
REDIS_HOST=teable-cache
REDIS_PORT=6379
REDIS_PASSWORD=teable
REDIS_DB=0
SECRET_KEY=localDevSecretKeyForSmokeTestOnlyNotForProduction
PUBLIC_ORIGIN=http://127.0.0.1:3000
BACKEND_STORAGE_PROVIDER=local