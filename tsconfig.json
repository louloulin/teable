{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "incremental": true,
    "newLine": "lf",
    "types": ["node"]
  },
  "files": [],
  "references": [
    { "path": "./apps/nestjs-backend" },
    { "path": "./apps/nextjs-app" },
    { "path": "./packages/core" },
    { "path": "./packages/openapi" },
    { "path": "./packages/db-main-prisma" },
    { "path": "./packages/db-data-prisma" },
    { "path": "./packages/formula" },
    { "path": "./packages/common-i18n" },
    { "path": "./packages/i18n-keys" },
    { "path": "./packages/sdk" },
    { "path": "./packages/ui-lib" },
    { "path": "./packages/icons" }
  ],
  "exclude": ["**/node_modules", "**/dist", "**/.next", "**/.git"]
}
